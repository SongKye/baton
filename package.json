{
  "name": "baton",
  "version": "0.8.5",
  "description": "One dashboard for your AI coding sessions — Claude Code, Codex, Antigravity, OpenCode and Cursor. Resume any session from desktop or phone.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --no-warnings server/index.js",
    "open": "node --no-warnings server/index.js --open",
    "setup": "bash scripts/setup.sh",
    "i18n:check": "node scripts/i18n-check.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "web-push": "^3.6.7"
  },
  "license": "MIT"
}
